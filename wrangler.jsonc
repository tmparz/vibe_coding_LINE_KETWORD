{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "line-ai-faq-course",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": { "GEMINI_MODEL": "gemini-2.5-flash", "BOOKING_ENABLED": "false" }
  // DAY 1 不需要 D1，也不需要 R2 或信用卡。
  // 如果選修 R2，再自行加入 r2_buckets binding 和 FAQ_SOURCE=r2。
}
